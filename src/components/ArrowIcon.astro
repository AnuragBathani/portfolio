---
// The repeated 14px arrow used across links/buttons.
// `dir`: "right" (default) | "left" | "out" (diagonal external).
interface Props {
  dir?: "right" | "left" | "out";
  class?: string;
}
const { dir = "right", class: className = "" } = Astro.props;
const paths = {
  right: "M3 8h10m-4-4 4 4-4 4",
  left: "M13 8H3m4 4-4-4 4-4",
  out: "M4 12L12 4M12 4H5M12 4V11",
};
---

<svg
  class={className}
  width="14"
  height="14"
  viewBox="0 0 16 16"
  fill="none"
  aria-hidden="true"
>
  <path
    d={paths[dir]}
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
</svg>
