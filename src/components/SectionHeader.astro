---
// Editorial section header: eyebrow (with amber tick) + serif title,
// followed by a hairline rule spanning to the column edge.
// Replaces the old GlitchText/flicker header.
interface Props {
  eyebrow: string;
  title: string;
  class?: string;
}
const { eyebrow, title, class: className = "" } = Astro.props;
---

<div class:list={["mb-8", className]}>
  <span class="eyebrow mb-3 block">{eyebrow}</span>
  <div class="flex items-end gap-5">
    <h2 class="font-serif text-display-md font-medium tracking-tight text-white whitespace-nowrap">
      {title}
    </h2>
    <span class="hairline-rule mb-2 hidden flex-1 sm:block"></span>
  </div>
</div>
