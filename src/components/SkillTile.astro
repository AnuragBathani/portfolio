---
import { skillIcons, fallbackIcon } from "@/lib/skillIcons";
interface Props {
  name: string;
}
const { name } = Astro.props;
const icon = skillIcons[name] ?? fallbackIcon;
---

<div class="skill-tile group relative flex cursor-default items-center justify-center">
  <span
    class="relative z-10 text-ink-400 transition-colors duration-[420ms] ease-silk group-hover:text-accent-soft [&>svg]:h-[22px] [&>svg]:w-[22px]"
    set:html={icon}
  />
  <span
    class="pointer-events-none absolute -bottom-8 left-1/2 z-20 -translate-x-1/2 translate-y-1 whitespace-nowrap rounded-md border border-white/10 bg-ink-900 px-2.5 py-1 font-mono text-[10px] tracking-wider text-ink-200 opacity-0 shadow-lg transition-all duration-300 ease-silk group-hover:translate-y-0 group-hover:opacity-100"
  >
    {name}
  </span>
</div>
