---
import Layout from "@/layouts/Layout.astro";
import Reveal from "@/components/Reveal.astro";
import ArrowIcon from "@/components/ArrowIcon.astro";
import { projects } from "@/data/content";

export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: {
      project,
      prev: i > 0 ? projects[i - 1] : null,
      next: i < projects.length - 1 ? projects[i + 1] : null,
    },
  }));
}

const { project, prev, next } = Astro.props;

const blocks = [
  { label: "The Problem", body: project.problem },
  { label: "The Approach", body: project.approach },
  { label: "Technical Details", body: project.techDetails },
].filter((b) => b.body);
---

<Layout
  title={`${project.title} — Anurag Bathani`}
  description={project.description}
>
  <main class="relative z-[2] min-h-screen pb-24 pt-32">
    <div class="mx-auto max-w-[900px] px-6 md:px-8">
      {/* Back link */}
      <Reveal>
        <a
          href="/projects"
          class="group mb-8 inline-flex items-center gap-2 font-mono text-[13px] tracking-wide text-ink-400 transition-colors duration-300 hover:text-white"
        >
          <ArrowIcon dir="left" class="transition-transform duration-300 group-hover:-translate-x-1" />
          Back to Projects
        </a>
      </Reveal>

      {/* Header */}
      <Reveal delay={0.1}>
        <span class="eyebrow mb-5 block">Project {project.number}</span>
        <h1 class="mb-5 font-serif text-display-md font-medium tracking-tight text-balance text-white">
          {project.title}
        </h1>
        <div class="mb-8 flex flex-wrap gap-2">
          {
            project.tags.map((t, i) => (
              <span
                class:list={[
                  "rounded-full border px-3 py-1 font-mono text-[11px] tracking-wide",
                  i === 0 ? "border-accent/30 text-accent-soft" : "border-white/[0.08] text-ink-300",
                ]}
              >
                {t}
              </span>
            ))
          }
        </div>
        <p class="lead mb-12 text-[15px] font-light leading-relaxed text-ink-200">
          {project.description}
        </p>
      </Reveal>

      {/* Problem / Approach / Tech */}
      {
        blocks.map((b, i) => (
          <Reveal delay={0.15 + i * 0.05}>
            <div class="mb-10">
              <h2 class="eyebrow mb-4">{b.label}</h2>
              <p class="max-w-[68ch] text-[15px] font-light leading-[1.85] text-ink-200">
                {b.body}
              </p>
            </div>
          </Reveal>
        ))
      }

      {/* Highlights */}
      <Reveal delay={0.3}>
        <div class="mb-12">
          <h2 class="eyebrow mb-5">Key Highlights</h2>
          <div class="grid gap-3 sm:grid-cols-2">
            {
              project.highlights.map((h) => (
                <div class="card-surface flex items-start gap-3 rounded-[14px] p-5">
                  <svg class="mt-0.5 shrink-0 text-accent" width="14" height="14" viewBox="0 0 16 16" fill="none">
                    <path d="M13.5 4.5L6 12l-3.5-3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <span class="text-sm font-light leading-relaxed text-ink-200">{h}</span>
                </div>
              ))
            }
          </div>
        </div>
      </Reveal>

      {/* GitHub link */}
      <Reveal delay={0.35}>
        <div class="mb-14 border-t border-white/[0.06] pt-8">
          <a
            href={project.link}
            target="_blank"
            rel="noopener"
            class="group inline-flex items-center gap-2 font-mono text-[13px] tracking-wide text-ink-300 transition-all duration-500 hover:gap-3.5 hover:text-white"
          >
            View on GitHub
            <ArrowIcon dir="out" class="transition-transform duration-500 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
          </a>
        </div>
      </Reveal>

      {/* Prev / Next */}
      <Reveal>
        <div class="flex flex-col gap-4 border-t border-white/[0.06] pt-8 md:flex-row md:justify-between">
          {
            prev ? (
              <a href={`/projects/${prev.slug}`} class="group flex items-center gap-3 text-ink-400 transition-colors duration-300 hover:text-white">
                <ArrowIcon dir="left" class="transition-transform duration-300 group-hover:-translate-x-1" />
                <span class="text-sm font-light">{prev.title}</span>
              </a>
            ) : (
              <div />
            )
          }
          {
            next && (
              <a href={`/projects/${next.slug}`} class="group flex items-center gap-3 text-ink-400 transition-colors duration-300 hover:text-white">
                <span class="text-sm font-light">{next.title}</span>
                <ArrowIcon class="transition-transform duration-300 group-hover:translate-x-1" />
              </a>
            )
          }
        </div>
      </Reveal>
    </div>
  </main>
</Layout>
