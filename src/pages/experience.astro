---
import Layout from "@/layouts/Layout.astro";
import Reveal from "@/components/Reveal.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import { experience, education } from "@/data/content";
import { md } from "@/lib/md";
---

<Layout title="Experience — Anurag Bathani" description="Work experience and education of Anurag Bathani, Cybersecurity Engineer.">
  <main class="relative z-[2] min-h-screen pb-24 pt-32">
    <div class="container-x">
      <Reveal>
        <span class="eyebrow mb-4 block">02 — Experience</span>
        <h1 class="mb-12 font-serif text-display-lg font-medium tracking-tight text-balance text-white">
          Experience
        </h1>
      </Reveal>

      {/* Work Experience */}
      <Reveal delay={0.1}>
        <div class="card-surface mb-12 rounded-2xl p-6 md:p-8">
          <div class="mb-7 flex flex-wrap items-start justify-between gap-6 border-b border-white/[0.06] pb-6">
            <div>
              <h2 class="mb-1.5 font-serif text-2xl font-medium tracking-tight text-white">
                {experience.company}
              </h2>
              <span class="font-mono text-[13px] text-accent-soft">
                {experience.role}
              </span>
            </div>
            <div class="text-right">
              <span class="block font-mono text-xs tracking-wide text-ink-300">
                {experience.date}
              </span>
              <span class="font-mono text-xs tracking-wide text-ink-400">
                {experience.location}
              </span>
            </div>
          </div>
          <ul class="flex flex-col gap-4">
            {
              experience.bullets.map((b) => (
                <li class="flex gap-4 text-[15px] font-light leading-[1.75] text-ink-200">
                  <span class="mt-3 h-1 w-1 shrink-0 rounded-full bg-accent" />
                  <span set:html={md(b)} />
                </li>
              ))
            }
          </ul>
        </div>
      </Reveal>

      {/* Education */}
      <Reveal delay={0.15}><SectionHeader eyebrow="Academic" title="Education" /></Reveal>
      <Reveal delay={0.2}>
        <div class="card-surface rounded-2xl p-6 md:p-8">
          <div class="mb-7 flex flex-wrap items-start justify-between gap-6 border-b border-white/[0.06] pb-6">
            <div>
              <h3 class="mb-1.5 font-serif text-2xl font-medium tracking-tight text-white">
                {education.school}
              </h3>
              <span class="font-mono text-[13px] text-ink-300">
                {education.degree}
              </span>
            </div>
            <div class="text-right">
              <span class="block font-mono text-xs tracking-wide text-ink-300">
                {education.date}
              </span>
              <span class="font-mono text-xs tracking-wide text-ink-400">
                {education.location}
              </span>
            </div>
          </div>
          <div class="flex items-baseline gap-5">
            <span class="font-mono text-[11px] uppercase tracking-[0.22em] text-ink-400">
              GPA
            </span>
            <span class="tabular-nums font-serif text-4xl font-medium tracking-tight text-white">
              {education.gpa.value}
              <span class="ml-2 text-base font-normal italic text-ink-400">
                / {education.gpa.total}
              </span>
            </span>
          </div>
        </div>
      </Reveal>

      {/* Resume CTA */}
      <Reveal delay={0.25}>
        <div class="mt-12">
          <a
            href="/resume.pdf"
            target="_blank"
            rel="noopener"
            class="btn-lift group inline-flex items-center gap-2 rounded-full border border-white/10 px-7 py-3.5 text-sm font-medium text-white transition-all duration-300 hover:border-white/30 hover:bg-white/[0.02]"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
            Download Full Resume
          </a>
        </div>
      </Reveal>
    </div>
  </main>
</Layout>
