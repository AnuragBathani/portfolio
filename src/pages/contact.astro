---
import Layout from "@/layouts/Layout.astro";
import Reveal from "@/components/Reveal.astro";
import ArrowIcon from "@/components/ArrowIcon.astro";
import { profile } from "@/data/content";

const contactLinks = [
  { label: "Email", value: profile.email, href: `mailto:${profile.email}` },
  {
    label: "GitHub",
    value: profile.github.replace("https://", ""),
    href: profile.github,
  },
  {
    label: "LinkedIn",
    value: profile.linkedin.replace("https://", ""),
    href: profile.linkedin,
  },
];
---

<Layout title="Contact — Anurag Bathani" description="Get in touch with Anurag Bathani — cybersecurity, DevSecOps, and new opportunities.">
  <main class="relative z-[2] min-h-screen pb-24 pt-32">
    <div class="container-x">
      <Reveal>
        <span class="eyebrow mb-4 block">07 — Contact</span>
        <h1 class="mb-4 font-serif text-display-lg font-medium tracking-tight text-balance text-white">
          Let&apos;s work together.
        </h1>
        <p class="lead mb-12 max-w-[52ch] text-lg font-light leading-relaxed text-ink-300">
          Have a security challenge, an interesting project, or just want to
          talk shop? I&apos;m always open to discussing cybersecurity,
          DevSecOps, and new opportunities.
        </p>
      </Reveal>

      <div class="flex flex-col gap-4">
        {
          contactLinks.map((l, i) => (
            <Reveal delay={0.1 + i * 0.08}>
              <a
                href={l.href}
                target={l.href.startsWith("http") ? "_blank" : undefined}
                rel="noopener"
                class="card-surface card-rule group flex flex-wrap items-center gap-4 rounded-[14px] px-8 py-7 transition-[transform,background-color,border-color] duration-500 hover:translate-x-1.5"
              >
                <span class="min-w-[80px] font-mono text-[11px] uppercase tracking-[0.25em] text-ink-400">
                  {l.label}
                </span>
                <span class="flex-1 font-serif text-lg tracking-tight text-ink-100">
                  {l.value}
                </span>
                <ArrowIcon
                  dir="out"
                  class="text-ink-400 transition-all duration-500 group-hover:translate-x-1 group-hover:-translate-y-1 group-hover:text-accent"
                />
              </a>
            </Reveal>
          ))
        }
      </div>

      <Reveal delay={0.35}>
        <div class="mt-12">
          <a
            href="/resume.pdf"
            target="_blank"
            rel="noopener"
            class="btn-lift group inline-flex items-center gap-2 rounded-full border border-white/10 px-7 py-3.5 text-sm font-medium text-white transition-all duration-300 hover:border-white/30 hover:bg-white/[0.02]"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
            Download Resume
          </a>
        </div>
      </Reveal>
    </div>
  </main>
</Layout>
