---
import Layout from "@/layouts/Layout.astro";
import Reveal from "@/components/Reveal.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import ArrowIcon from "@/components/ArrowIcon.astro";
import { resources } from "@/data/content";
---

<Layout title="Resources — Anurag Bathani" description="Security tools, learning platforms, and reading material recommended by Anurag Bathani.">
  <main class="relative z-[2] min-h-screen pb-24 pt-32">
    <div class="container-x">
      <Reveal>
        <span class="eyebrow mb-4 block">Resources</span>
        <h1 class="mb-4 font-serif text-display-lg font-medium tracking-tight text-balance text-white">
          Resources
        </h1>
        <p class="lead mb-16 max-w-[60ch] text-[15px] font-light leading-relaxed text-ink-300">
          Tools, platforms, and reading material I recommend for anyone
          interested in cybersecurity.
        </p>
      </Reveal>

      {/* Security Tools */}
      <Reveal><SectionHeader eyebrow="Toolkit" title="Security Tools" /></Reveal>
      <div class="mb-20 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {
          resources.tools.map((tool, i) => (
            <Reveal delay={0.05 + i * 0.06}>
              <a
                href={tool.url}
                target="_blank"
                rel="noopener"
                class="card-surface card-rule group flex h-full flex-col rounded-xl p-7 transition-transform duration-500 hover:-translate-y-1"
              >
                <span class="mb-3 inline-block self-start rounded-full border border-white/[0.08] px-2.5 py-0.5 font-mono text-[10px] text-ink-400">
                  {tool.category}
                </span>
                <h3 class="mb-2 font-serif text-lg font-medium tracking-tight transition-colors duration-300 group-hover:text-white">
                  {tool.name}
                </h3>
                <p class="flex-1 text-sm font-light leading-relaxed text-ink-400">
                  {tool.description}
                </p>
                <div class="mt-4 flex items-center gap-2 font-mono text-[11px] tracking-wide text-ink-500 transition-colors duration-300 group-hover:text-accent">
                  Visit
                  <ArrowIcon dir="out" class="h-2.5 w-2.5 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
                </div>
              </a>
            </Reveal>
          ))
        }
      </div>

      {/* Learning Platforms */}
      <Reveal><SectionHeader eyebrow="Practice" title="Learning Platforms" /></Reveal>
      <div class="mb-20 grid gap-4 md:grid-cols-2">
        {
          resources.learning.map((platform, i) => (
            <Reveal delay={i * 0.06}>
              <a
                href={platform.url}
                target="_blank"
                rel="noopener"
                class="card-surface group flex items-start gap-5 rounded-xl p-7 transition-transform duration-500 hover:-translate-y-0.5"
              >
                <div class="flex-1">
                  <h3 class="mb-2 font-serif text-lg font-medium tracking-tight transition-colors duration-300 group-hover:text-white">
                    {platform.name}
                  </h3>
                  <p class="text-sm font-light leading-relaxed text-ink-400">
                    {platform.description}
                  </p>
                </div>
                <ArrowIcon dir="out" class="mt-1 shrink-0 text-ink-500 transition-all duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-accent" />
              </a>
            </Reveal>
          ))
        }
      </div>

      {/* Reading List */}
      <Reveal><SectionHeader eyebrow="Bookshelf" title="Reading List" /></Reveal>
      <div class="grid gap-4 md:grid-cols-2">
        {
          resources.reading.map((book, i) => (
            <Reveal delay={i * 0.06}>
              <div class="card-surface rounded-xl p-7">
                <h3 class="mb-1 font-serif text-lg font-medium tracking-tight text-white">
                  {book.title}
                </h3>
                <span class="mb-3 block font-mono text-[12px] text-ink-400">
                  by {book.author}
                </span>
                <p class="text-sm font-light leading-relaxed text-ink-400">
                  {book.description}
                </p>
              </div>
            </Reveal>
          ))
        }
      </div>
    </div>
  </main>
</Layout>
